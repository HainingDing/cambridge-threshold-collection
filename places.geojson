---
layout: null
---
{
  "type": "FeatureCollection",
  "features": [
{% assign items = site.cases | where_exp: "c", "c.published == true" | sort: "code" %}{% for c in items %}    {
      "type": "Feature",
      "geometry": {"type": "Point", "coordinates": [{{ c.lon }}, {{ c.lat }}]},
      "properties": {
        "code": {{ c.code | jsonify }},
        "name": {{ c.name | jsonify }},
        "layer": {{ c.layer | jsonify }},
        "tags": {{ c.tags | jsonify }},
        "cargo_url": {{ c.cargo_url | jsonify }}
      }
    }{% unless forloop.last %},{% endunless %}
{% endfor %}  ]
}
